{
  "name": "cove-client",
  "version": "1.3.0",
  "description": "Cove - 即时通讯客户端",
  "author": "Cove",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "remote-input:build": "node electron/build-remote-input.cjs",
    "electron:compile": "npm run remote-input:build && tsc -p electron/tsconfig.json",
    "test:updater": "npm run electron:compile && node --test tests/updater.test.cjs tests/gitee-installer-cache.test.cjs tests/server-certificate-policy.test.cjs",
    "test:connection": "tsx --test tests/connectionDeadline.test.ts tests/sessionRegistration.test.ts tests/voiceConnectionRecovery.test.ts",
    "test:audio-devices": "tsx --test tests/audioDevices.test.ts tests/remoteAudioPlayback.test.ts tests/applicationAudio.test.ts tests/microphoneProcessing.test.ts tests/microphoneEcho.test.ts",
    "test:microphone-echo": "electron tests/microphoneEcho.electron.cjs",
    "test:microphone": "electron tests/microphoneProcessing.electron.cjs",
    "test:rnnoise": "tsx --test tests/rnnoise.test.ts && electron tests/rnnoise.electron.cjs",
    "test:chat-images": "tsx --test tests/chatImages.test.ts",
    "test:chat-links": "tsx --test tests/chatLinks.test.ts",
    "test:media-diagnostics": "tsx --test tests/mediaDiagnostics.test.ts",
    "test:screen-capture": "tsx --test tests/screenCapture.test.ts",
    "test:member-ordering": "tsx --test tests/memberOrdering.test.ts",
    "test:account-auth": "tsx --test tests/accountAuth.test.ts",
    "test:remote-control": "tsx --test tests/remoteControl.test.ts tests/remoteInputQueue.test.ts tests/remoteInputController.test.ts tests/remoteControlSession.test.ts tests/remoteInputHelper.test.ts",
    "test:rooms": "tsx --test tests/roomSettings.test.ts",
    "test:sortable": "tsx --test tests/sortableList.test.ts",
    "test:soundpack-download": "tsx --test tests/soundpackDownload.test.ts",
    "test:update-center": "tsx --test tests/updateCenter.test.ts",
    "test": "npm run test:updater && npm run test:connection && npm run test:audio-devices && npm run test:chat-images && npm run test:chat-links && npm run test:media-diagnostics && npm run test:screen-capture && npm run test:member-ordering && npm run test:account-auth && npm run test:remote-control && npm run test:rooms && npm run test:sortable && npm run test:soundpack-download && npm run test:update-center",
    "electron:dev": "npm run electron:compile && electron .",
    "build": "tsc && vite build",
    "build:electron": "npm run build && npm run electron:compile && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.9",
    "loopback-capture": "^2.0.0",
    "lucide-react": "^1.33.0",
    "mediasoup-client": "^3.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.cove.app",
    "productName": "Cove",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist-app"
    },
    "artifactName": "Cove-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "LumineTraveller",
        "repo": "Cove",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/{react,react-dom,react-router,react-router-dom,@remix-run/router,lucide-react,@phosphor-icons/react,mediasoup-client,socket.io-client,@socket.io,engine.io-client,engine.io-parser,socket.io-parser,xmlhttprequest-ssl,ws}/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.{ts,mts,cts}"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "extraResources": [
        {
          "from": "build/remote-input-helper.exe",
          "to": "remote-input-helper.exe"
        }
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
